rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Caminata is private to one household: both of us see and edit the same
    // walks. Signing in is the gate, not a way of telling us apart -- so there
    // is one shared collection and the only question asked is whether the
    // account is one of ours.
    //
    // The email has to be verified, or anyone could claim an address in a
    // sign-in provider that does not check it. Google always verifies.
    function isHousehold() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
             'cardozocristian@gmail.com',
             'pereznatalialourdes@gmail.com'
           ];
    }

    match /walks/{walkId} {
      allow read, delete: if isHousehold();

      // No Cloud Function sits in front of this -- the phone writes straight
      // here -- so the shape is checked on the way in rather than taken on
      // trust.
      allow create, update: if isHousehold()
        && request.resource.data.keys().hasOnly([
             'startedAt', 'endedAt', 'distance', 'movingTime',
             'elevationGain', 'pointCount', 'route', 'uploadedAt',
             'name', 'routeColor', 'breaks'
           ])
        && request.resource.data.startedAt is timestamp
        && request.resource.data.endedAt is timestamp
        && request.resource.data.distance is number
        && request.resource.data.distance >= 0
        && request.resource.data.movingTime is number
        && request.resource.data.movingTime >= 0
        && request.resource.data.elevationGain is number
        && request.resource.data.pointCount is int
        && request.resource.data.route is list
        // Flat [lat, lng, ...] pairs, and small enough to stay well inside the
        // 1 MiB document limit however long the walk was.
        && request.resource.data.route.size() % 2 == 0
        && request.resource.data.route.size() <= 20000
        && (!('name' in request.resource.data)
            || request.resource.data.name == null
            || (request.resource.data.name is string
                && request.resource.data.name.size() <= 80))
        // Where the route restarts after a pause, as point indices.
        && (!('breaks' in request.resource.data)
            || (request.resource.data.breaks is list
                && request.resource.data.breaks.size() <= 1000))
        && (!('routeColor' in request.resource.data)
            || (request.resource.data.routeColor is string
                && request.resource.data.routeColor.matches('^#[0-9A-Fa-f]{6}$')));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
